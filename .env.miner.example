SUBTENSOR_NETWORK=wss://entrypoint-finney.opentensor.ai:443
WALLET_NAME=miner
HOTKEY=default
NETUID=82
EXTERNAL_IP=_YOUR_EXTERNAL_IP_HERE__
PORT=8086

BOARD_SERVICE=https://api-hermes.subquery.network

# OpenRouter API — set your key here. All models below route through openrouter.ai.
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-xxx

# ─── Model Selection ──────────────────────────────────────────────────────────
#
# MINER_LLM_MODEL  — outer miner agent that decides which project tool to call
#   and produces the FINAL natural-language answer seen by validators.
#   Recommendation: a fast, instruction-following model with strong reasoning.
#   Best choices (in order):
#     google/gemini-2.5-pro           — best accuracy, higher latency/cost
#     google/gemini-2.5-flash         — great accuracy, much faster (recommended)
#     anthropic/claude-sonnet-4-5     — strong NL output, reliable tool use
#     moonshotai/kimi-k2-0905         — very fast, good GraphQL reasoning
#     google/gemini-2.0-flash-001     — fast fallback
#
MINER_LLM_MODEL=google/gemini-2.5-flash

# LLM_MODEL — inner GraphQL agent that translates the question into GraphQL
#   queries, executes them, and returns raw data to the outer agent.
#   Must be strong at schema understanding and multi-step tool use.
#   Best choices (in order):
#     google/gemini-2.5-pro           — best for complex multi-hop queries
#     google/gemini-2.5-flash         — good balance of speed and accuracy
#     anthropic/claude-sonnet-4-5     — reliable, clean tool-call chains
#     moonshotai/kimi-k2-0905         — low latency, good GraphQL coverage
#
LLM_MODEL=google/gemini-2.5-flash

# ─── Performance Tuning ───────────────────────────────────────────────────────
# Validators apply a time penalty: responses slower than ~80% of the validator's
# own ground-truth time score 0. Keep both models fast.
# Use temperature=0 for deterministic, accurate answers (set in code).

# Enable only when you have a custom optimised LLM wired up as a tool
ENABLE_FALL_BACK_GRAPHQL_AGENT=false

# The Graph API token for querying subgraph data, needed for TheGraph projects
# free api token can be obtained from https://thegraph.com/docs/en/subgraphs/querying/managing-api-keys/
THEGRAPH_API_TOKEN=xx
